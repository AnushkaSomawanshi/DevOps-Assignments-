# Ignore dependencies and build artifacts
**/node_modules
**/dist
**/build
**/.turbo

# Ignore version control and secrets
.git
.gitignore
.env
.env.*
!.env.example

# Ignore documentation, evidence, and infrastructure files from container build context
docs/
evidence/
infrastructure/
*.md
LICENSE

# Ignore logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp/
temp/

# Ignore IDE, OS, and editor files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore legacy/sample folders
docker/python-app/
