# ==============================================================================
# GyneCare DevOps Project - Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)
# ==============================================================================

# Application Service Ports
PORT=5000
FRONTEND_PORT=3000
MONGO_PORT=27017

# Database Configuration
MONGO_DATABASE=hospitalDB
# For local bare-metal run:
MONGO_URI=mongodb://127.0.0.1:27017/hospitalDB
# In Docker Compose, the backend automatically uses mongodb://mongodb:27017/hospitalDB

# Optional External API Keys (Leave blank if not configured)
GEMINI_API_KEY=

# Cloud & IaC Configuration Placeholders (Assignment 2 & 3)
AWS_REGION=us-east-1
S3_BUCKET_NAME=
